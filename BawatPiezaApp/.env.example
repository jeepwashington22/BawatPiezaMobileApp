# Express API that brokers the two-factor sign-in (POST /accounts/2fa/*).
# Optional fallback/pin: the app auto-detects your PC's LAN IP at runtime from
# expo-constants (Constants.expoConfig.hostUri) while Metro runs with --lan.
# Set a public HTTPS URL here for a hosted API, or a LAN IP to pin one
# explicitly (e.g. http://192.168.1.10:4000).
EXPO_PUBLIC_API_URL=http://localhost:4000

# Optional: API port when the app derives the host itself. Default 4000.
# EXPO_PUBLIC_API_PORT=4000

# Google Sign-In (native + OAuth)
#
# EXPO_PUBLIC_GOOGLE_CLIENT_ID must be an OAuth client of type
#   "Web application" from the Google Cloud Console.
#
# Why the *Web* client on a phone:
#   1. Supabase's Google provider is configured with that exact client ID +
#      secret, so it is the client Google must stamp as the token audience.
#   2. `@react-native-google-signin/google-signin` is configured with it as
#      `webClientId`; Android/iOS then return an ID token for that audience,
#      which `supabase.auth.signInWithIdToken()` accepts. This is the flow that
#      keeps sign-in inside the app (no browser, no redirect).
#
# Also required outside this file:
#   - Google Cloud Console → Credentials → create an "Android" OAuth client with
#     the package name from app.json (android.package) and your signing SHA-1.
#   - Supabase Dashboard → Authentication → Providers → Google → enable, paste
#     the Web client ID + secret, and add the same IDs under
#     "Authorized Client IDs".
#   - Supabase Dashboard → Authentication → URL Configuration → set the Site URL
#     to bawatpiezaapp://oauth (never leave it at http://localhost:3000) and add
#     bawatpiezaapp://oauth plus the Expo Go/web origins to Redirect URLs.
#     Type those values WITHOUT quotes, one per line, and replace any <LAN-IP>
#     placeholder with your PC's real LAN IP — the dialog rejects both.
#
# See docs/features/google-sign-in.md for the full walkthrough.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Optional — only needed for iOS builds: the OAuth client of type "iOS".
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com

# Opt-in browser fallback for a native binary WITHOUT the Google module (Expo Go).
#
# Off by default: Google's account sheet is a native SDK, so browser-free
# sign-in in Expo Go is impossible. With this unset, pressing "Sign in with
# Google" in Expo Go shows an actionable "needs a development build" message
# instead of silently opening a browser.
#
# Set to 1 to open Google's consent screen in a browser tab instead. The
# round trip comes back INTO Expo Go through Linking.createURL("/oauth") — an
# exp:// deep link, which Expo Go does register (the app's own
# bawatpiezaapp:// scheme is the one that is not registered there). It only
# completes once that exp:// URL is allow-listed under Supabase →
# Authentication → URL Configuration → Redirect URLs, so the Metro/LAN host
# must match what you allow-listed. This project's .env ships with =1 — see
# docs/features/google-sign-in.md.
# EXPO_PUBLIC_GOOGLE_BROWSER_FALLBACK=1
