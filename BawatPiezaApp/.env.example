# Express API that brokers the two-factor sign-in (POST /accounts/2fa/*).
# Use http://localhost:4000 for web/emulators; use your machine's LAN IP
# (e.g. http://192.168.1.10:4000) when testing on a physical device.
EXPO_PUBLIC_API_URL=http://localhost:4000

# Google OAuth Configuration (for Google Sign-In)
# Obtain these from Google Cloud Console: https://console.cloud.google.com
# 1. Create OAuth 2.0 Client ID (Web application type)
# 2. Add authorized redirect URIs for your app
# 3. Also configure in Supabase Dashboard: Authentication > Providers > Google
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
