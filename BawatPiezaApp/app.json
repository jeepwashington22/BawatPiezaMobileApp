{
  "expo": {
    "name": "BawatPieza",
    "slug": "BawatPiezaApp",
    "newArchEnabled": false,
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/LOGO4.png",
    "scheme": "bawatpieza",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.bawatpieza.app",
      "icon": "./assets/images/LOGO4.png",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.bawatpieza.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/LOGO4.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },

    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow BawatPieza to scan Wi-Fi QR codes",
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/LOGO4.png",
          "imageWidth": 120
        }
      ],
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-image",
      "expo-web-browser",
      "expo-video",
      "expo-audio",
      "expo-asset",
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "newArchEnabled": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a3bceb11-118f-4736-9a70-5e3234917186"
      }
    }
  }
}
