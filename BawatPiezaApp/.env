# Backend API base URL — fallback only. The app auto-detects your PC's LAN IP at
# runtime (expo-constants hostUri from Metro), so you normally do not need this.
# Set it to pin an address or to point at a hosted/tunnelled API.
EXPO_PUBLIC_API_URL=http://192.168.1.9:4000

# Google OAuth Configuration
# These are required for Google Sign-In via Supabase OAuth
# To get these credentials:
# 1. Go to Google Cloud Console (https://console.cloud.google.com)
# 2. Create a new OAuth 2.0 Client ID (Web application type)
# 3. Add authorized redirect URIs: https://<your-project>.supabase.co/auth/v1/callback
# 4. Copy the Client ID and Client Secret
# 5. Add them to your Supabase project under Authentication > Settings > OAuth
EXPO_PUBLIC_GOOGLE_CLIENT_ID=890013660689-o12lil5drhfp9dauic4ic81v0ccvk1ir.apps.googleusercontent.com
# Google sign-in inside Expo Go (browser round trip).
# Expo Go's binary has no RNGoogleSignin native module, so Google's native
# account sheet cannot load there. =1 makes the app open Google's consent
# screen in a browser tab instead and return through the
# exp://<metro-host>:8081/--/oauth deep link. Requires that URL to be
# allow-listed under Supabase -> Authentication -> URL Configuration ->
# Redirect URLs (the exact value is printed in the Metro console as
# "[google] Browser fallback redirect -> ..."). See docs/features/google-sign-in.md.
EXPO_PUBLIC_GOOGLE_BROWSER_FALLBACK=1
