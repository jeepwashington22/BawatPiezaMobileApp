# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Supabase (Project Settings > API)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# Login two-factor (email OTP). Leave unset, or set to true, to REQUIRE the
# 6-digit code emailed at sign-in. Set to false only for local development or
# automated tests where no mailbox is reachable — it makes the password the
# only factor again, so never disable it in production.
LOGIN_2FA_ENABLED=true

# Redis - either Upstash REST (recommended for serverless) or a TCP URL
UPSTASH_REDIS_REST_URL=https://YOUR_DB.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token
# REDIS_URL=redis://localhost:6379

# Set true to skip Redis/Supabase checks in /health (liveness probes)
HEALTH_LIVENESS_ONLY=false

# Brevo SMTP (email notifications)
# 1. Login to Brevo, go to SMTP & API > SMTP keys, copy an SMTP key (starts with "xsmtpsib-")
# 2. Verify a sender address under Settings > Senders/IPs
# 3. BREVO_SMTP_USER must be the email you use to log into Brevo
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_SECURE=false
BREVO_SMTP_USER=your-brevo-login-email@example.com
BREVO_SMTP_KEY=xsmtpsib-YOUR_SMTP_KEY
MAIL_FROM=your-verified-sender@example.com
MAIL_FROM_NAME=BawatPieza
